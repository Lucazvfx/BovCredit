# Copie para .env e preencha os valores reais.
# NUNCA commite o .env — ele já está no .gitignore.

# ── Banco: Supabase ──────────────────────────────────────────────────────────
# Painel do Supabase → Project Settings → Database → Connection string → URI.
#
# USE A DO CONNECTION POOLER (porta 6543, modo Transaction), não a conexão
# direta na 5432. database.py abre e fecha conexão a cada consulta, e o
# gunicorn roda com múltiplas threads: pela porta direta isso estoura o limite
# de conexões do projeto Supabase em carga normal.
#
# O host do pooler tem a forma aws-0-<regiao>.pooler.supabase.com e o usuário
# carrega o ref do projeto (postgres.<ref>). Mantenha o sslmode=require.
DATABASE_URL=postgresql://postgres.SEUPROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ── Flask ────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_chave_aleatoria

# Admin inicial (criado na primeira subida)
ADMIN_EMAILS=seu@email.com
ADMIN_SENHA_INICIAL=troque_na_primeira_entrada

# IA
GROQ_API_KEY=gsk_...

# URL pública do app (sem barra no final)
APP_URL=https://credito.orkavyn.tech

# Redis (opcional — sem Redis usa memória, sem persistência entre reinícios)
# RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Entrar com Google (opcional — sem estas duas o botão nem aparece na tela).
# Console do Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth
# (tipo "Aplicativo da Web"). Em "URIs de redirecionamento autorizados" ponha
# exatamente:  https://SEU-DOMINIO/entrar/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Domínios cujo e-mail pode CRIAR conta sozinho ao entrar pelo Google.
# Vazio = ninguém novo entra; só quem o admin já cadastrou.
# Quem entra por aqui cai na empresa do domínio, se houver só uma; havendo
# zero ou mais de uma, a conta nasce sem empresa e o admin vincula.
# DOMINIOS_PERMITIDOS=suaconsultoria.com.br

# Chave que cifra o segredo TOTP no banco (opcional).
# Sem ela, a chave é derivada da SECRET_KEY — o que funciona, mas amarra as
# duas: trocar a SECRET_KEY torna os segredos 2FA ilegíveis e todo mundo
# precisa entrar pelo código de backup e reativar o 2FA.
# Defina antes de rotacionar a SECRET_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOTP_CHAVE=
